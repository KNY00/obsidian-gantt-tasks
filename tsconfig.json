{
    "compilerOptions": {
        "target": "es2022",
        "module": "commonjs",
        "checkJs": true,
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        }
    },
    "include": [
        "src/**/*",
        "tests/**/*",
        "**/*.ts",
        "**/*.js",
        "**/*.d.ts",
    ]
}